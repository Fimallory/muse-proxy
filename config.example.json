{
  "listen": "0.0.0.0:8080",
  "server_keys": [
    "change-this-local-key"
  ],
  "zen_key": "oc_sk-your-zen-key",
  "upstream": "https://opencode.ai/zen",
  "proxies": [
    "direct"
  ],
  "reuse_proxy_connections": false,
  "prefer_direct": true,
  "direct_cooldown_seconds": 120,
  "pool_max_attempts": 3,
  "hash_store_path": "/var/lib/muse-proxy/hashes.json",
  "hash_ttl_days": 3,
  "hash_max_entries": 50000,
  "hash_prefix_chars": 10000,
  "catalog_url": "https://models.opencode.ai/api.json",
  "catalog_path": "/var/lib/muse-proxy/catalog.json",
  "catalog_refresh_hours": 24,
  "proxy_sources": [
    {
      "url": "https://proxy-list-converter.lynn3t.workers.dev/fimall/proxy/list/US",
      "test_url": "https://opencode.ai/zen/v1/models",
      "timeout_seconds": 8,
      "concurrency": 48,
      "max_keep": 40,
      "refresh_hours": 3
    }
  ],
  "retry_empty": true,
  "max_empty_retries": 2,
  "request_timeout_seconds": 600
}