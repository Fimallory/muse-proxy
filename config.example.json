{
  "listen": "0.0.0.0:8080",
  "server_keys": [
    "change-this-local-key"
  ],
  "zen_key": "public",
  "upstream": "https://opencode.ai/inference",
  "proxies": [
    "direct"
  ],
  "reuse_proxy_connections": false,
  "prefer_direct": true,
  "direct_cooldown_seconds": 120,
  "pool_max_attempts": 3,
  "hash_store_path": "/var/lib/muse-proxy/hashes.json",
  "hash_ttl_days": 3,
  "hash_max_entries": 50000,
  "hash_prefix_chars": 10000,
  "catalog_url": "https://models.opencode.ai/api.json",
  "catalog_path": "/var/lib/muse-proxy/catalog.json",
  "catalog_refresh_hours": 24,
  "free_only": true,
  "proxy_sources": [
    {
      "url": "https://raw.githubusercontent.com/monosans/proxy-list/main/proxies/http.txt",
      "protocol": "http",
      "test_url": "https://opencode.ai/inference/v1/models",
      "timeout_seconds": 8,
      "concurrency": 48,
      "max_keep": 200,
      "refresh_hours": 3
    },
    {
      "url": "https://raw.githubusercontent.com/monosans/proxy-list/main/proxies/socks5.txt",
      "protocol": "socks5",
      "test_url": "https://opencode.ai/inference/v1/models",
      "timeout_seconds": 8,
      "concurrency": 48,
      "max_keep": 200,
      "refresh_hours": 3
    },
    {
      "url": "https://raw.githubusercontent.com/zloi-user/hideip.me/main/socks5.txt",
      "protocol": "socks5",
      "test_url": "https://opencode.ai/inference/v1/models",
      "timeout_seconds": 8,
      "concurrency": 48,
      "max_keep": 200,
      "refresh_hours": 3
    },
    {
      "url": "https://api.proxyscrape.com/v4/free-proxy-list/get?request=display_proxies&protocol=http&proxy_format=ipport&format=text",
      "protocol": "http",
      "test_url": "https://opencode.ai/inference/v1/models",
      "timeout_seconds": 8,
      "concurrency": 48,
      "max_keep": 200,
      "refresh_hours": 3
    },
    {
      "url": "https://raw.githubusercontent.com/TheSpeedX/PROXY-List/master/socks5.txt",
      "protocol": "socks5",
      "test_url": "https://opencode.ai/inference/v1/models",
      "timeout_seconds": 8,
      "concurrency": 48,
      "max_keep": 200,
      "refresh_hours": 3
    },
    {
      "url": "https://raw.githubusercontent.com/roosterkid/openproxylist/main/HTTPS_RAW.txt",
      "protocol": "http",
      "test_url": "https://opencode.ai/inference/v1/models",
      "timeout_seconds": 8,
      "concurrency": 48,
      "max_keep": 200,
      "refresh_hours": 3
    }
  ],
  "retry_empty": true,
  "max_empty_retries": 2,
  "empty_guard_timeout_seconds": 30,
  "request_timeout_seconds": 600
}